{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "diner-pwa": {
      "projectType": "application",
      "root": "apps/diner-pwa",
      "sourceRoot": "apps/diner-pwa/src",
      "prefix": "itd",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/diner-pwa/src/main.ts",
            "index": "apps/diner-pwa/src/index.html",
            "tsConfig": "apps/diner-pwa/tsconfig.app.json",
            "styles": [
              "libs/shared/ui-tokens/src/lib/tokens.css",
              "apps/diner-pwa/src/styles.css"
            ],
            "outputPath": "dist/diner-pwa",
            "assets": [
              {
                "glob": "sw.js",
                "input": "apps/diner-pwa/src",
                "output": "/"
              },
              {
                "glob": "manifest.webmanifest",
                "input": "apps/diner-pwa/src",
                "output": "/"
              }
            ],
            "polyfills": [
              "zone.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kb",
                  "maximumError": "500kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "diner-pwa:build:production"
            },
            "development": {
              "buildTarget": "diner-pwa:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
