{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "../../dist/api",
    "rootDir": "../..",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "../../libs/**/*.ts"],
  "exclude": [
    "../../libs/**/*.spec.ts",
    "../../libs/**/ui-tokens/**",
    "../../libs/**/ui-image-editor/**",
    "../../libs/**/ui-auth/**",
    "**/*.spec.ts"
  ],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
