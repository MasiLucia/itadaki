{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "outDir": "../../dist/out-tsc/diner-pwa"
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts"],
  "//": "Los specs corren con jest, que usa tsconfig.base.json y trae los tipos de jest. Dentro del build de la app no existe `expect` y rompe la compilación.",
  "exclude": ["src/**/*.spec.ts"]
}
